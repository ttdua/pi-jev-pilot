{
  "ignorePatterns": ["tests/fixtures/**", "node_modules/**", "packages/**"],
  "rules": {
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": true,
        "skipComments": true,
        "IIFEs": true
      }
    ],
    "eslint/complexity": ["error", 12],
    "eslint/max-params": ["error", 4],
    "eslint/max-statements": ["error", 25],
    "eslint/max-depth": ["error", 4]
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "eslint/complexity": "off",
        "eslint/max-params": "off",
        "eslint/max-statements": "off",
        "eslint/max-depth": "off"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "shared/ imports nothing outside itself."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../host/**"],
                "message": "store/ must not import host/."
              },
              {
                "group": ["../jev/**"],
                "message": "store/ must not import jev/."
              },
              {
                "group": ["../policy/**"],
                "message": "store/ must not import policy/."
              },
              {
                "group": ["../extension*"],
                "message": "store/ must not import the entry point."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/policy/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "!../policy/**", "!../shared/**"],
                "message": "policy/ imports only itself and shared/."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              },
              {
                "group": ["./[!.]*/**", "!./[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/policy/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../**", "!../../policy/**", "!../../shared/**"],
                "message": "policy/ imports only itself and shared/."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              },
              {
                "group": ["../[!.]*/**", "!../[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/policy/*/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../../**", "!../../../policy/**", "!../../../shared/**"],
                "message": "policy/ imports only itself and shared/."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              },
              {
                "group": ["../../[!.]*/**", "!../../[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/host/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../extension*"],
                "message": "host/ must not import the entry point."
              },
              {
                "group": ["./[!.]*/**", "!./[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              },
              {
                "group": ["../policy/[!.]*/**", "!../policy/[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/host/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../extension*"],
                "message": "host/ must not import the entry point."
              },
              {
                "group": ["../[!.]*/**", "!../[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              },
              {
                "group": ["../../policy/[!.]*/**", "!../../policy/[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/host/*/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../../extension*"],
                "message": "host/ must not import the entry point."
              },
              {
                "group": ["../../[!.]*/**", "!../../[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              },
              {
                "group": ["../../../policy/[!.]*/**", "!../../../policy/[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/extension*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./policy/**"],
                "message": "The entry point wires only host/."
              },
              {
                "group": ["./jev/**"],
                "message": "The entry point wires only host/."
              },
              {
                "group": ["./store/**"],
                "message": "The entry point wires only host/."
              },
              {
                "group": ["./shared/**"],
                "message": "The entry point wires only host/."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              },
              {
                "group": ["./host/[!.]*/**", "!./host/[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/jev/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../host/**"],
                "message": "jev/ must not import host/."
              },
              {
                "group": ["../store/**"],
                "message": "jev/ must not import store/."
              },
              {
                "group": ["../extension*"],
                "message": "jev/ must not import the entry point."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              },
              {
                "group": ["../policy/[!.]*/**", "!../policy/[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/src/host/**"],
                "message": "scripts/ must not import host/."
              },
              {
                "group": ["**/src/store/**"],
                "message": "scripts/ must not import store/."
              },
              {
                "group": ["@earendil-works/*"],
                "message": "Only host/ may import Pi."
              },
              {
                "group": ["**/src/policy/[!.]*/**", "!**/src/policy/[!.]*/index.ts"],
                "message": "Use the capability's index.ts."
              }
            ]
          }
        ]
      }
    }
  ]
}
