{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@ttdua/pi-subagents": ["./packages/pi-subagents/dist/public.d.ts"]
    }
  },
  "include": ["src", "tests", "scripts"],
  "exclude": ["tests/fixtures", "packages"]
}
